{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/collections",
      "destination": "/collections.html"
    },
    {
      "source": "/statements",
      "destination": "/statements.html"
    },
    {
      "source": "/bespoke",
      "destination": "/bespoke.html"
    },
    {
      "source": "/atelier",
      "destination": "/atelier.html"
    },
    {
      "source": "/chronicles",
      "destination": "/chronicles.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/checkout",
      "destination": "/checkout.html"
    },
    {
      "source": "/product",
      "destination": "/product.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}